# ---- Database ----
# Local dev: your local Postgres. In the Coolify stack this is composed
# automatically from POSTGRES_PASSWORD (see docker-compose.yml).
DATABASE_URL="postgresql://user@localhost:5432/sparklet"
POSTGRES_PASSWORD="change-me"

# ---- Auth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public URL of the deployed app (e.g. https://sparklet.example.com)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth: console.cloud.google.com -> APIs & Services -> Credentials
# -> OAuth client ID (web application). Authorized redirect URI:
# <NEXTAUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple: developer.apple.com -> Certificates, Identifiers &
# Profiles. AUTH_APPLE_SECRET is NOT a static secret — it's a JWT you sign
# with your Apple private key (max 6-month expiry, must be regenerated).
# `npx auth add apple` will prompt for your Team ID / Key ID / .p8 file and
# write both vars here for you. Apple requires HTTPS — this provider is
# untestable on http://localhost, only against the deployed app.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ---- Admin ----
# Comma-separated emails allowed into /admin (moderation queue, card review)
ADMIN_EMAILS=""

# ---- Magic-link email ----
# SMTP connection string, e.g. smtp://user:pass@smtp.resend.com:587
# Leave EMPTY in dev: magic links are printed to the server console instead.
EMAIL_SERVER=""
EMAIL_FROM="Sparklet <login@yourdomain.com>"

# ---- AI providers ----
# Used by generation scripts/CI, and (if set on the server) by import-time
# fact-checking, embedding dedup, and lazy depth-variant generation.
GEMINI_API_KEY=""
GROQ_API_KEY=""
# GIPHY API key (free at developers.giphy.com) — content import falls back to
# a topical GIF when a card has no Wikipedia image. Unset = no GIF fallback.
GIPHY_API_KEY=""
# Shared secret for cron-called endpoints (weekly source re-validation,
# push nudges). Generate with: openssl rand -hex 24. Also set as a GitHub
# Actions secret.
REVALIDATE_TOKEN=""

# ---- Stripe (Premium subscription) ----
# Unset STRIPE_SECRET_KEY = billing routes 503, Upgrade CTAs hidden, and
# DEEP/EXTRA_DEEP reading depth is free for everyone (isPremium() short-circuits).
# Secret + webhook signing secret from dashboard.stripe.com/apikeys and the
# webhook endpoint you register there (POST <NEXTAUTH_URL>/api/billing/webhook).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring Price IDs (price_...) for the two plans, created in the Stripe
# Dashboard under Product catalog. Local testing: use test-mode keys/prices
# and `stripe listen --forward-to localhost:3001/api/billing/webhook`.
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_ANNUAL=""

# ---- Apple IAP (iOS premium) ----
# The app's numeric App Store id, from App Store Connect. Unset = signed
# transactions are only verified against Sandbox (and Xcode outside
# production) — see src/lib/apple-iap.ts. Production receipts cannot verify
# without it.
APPLE_APP_STORE_ID=""

# ---- Google Play billing (Android premium) ----
# Service-account JSON key with Play Developer API access, as a SINGLE LINE.
# Unset = isGooglePlayBillingEnabled() false, /api/billing/google/verify
# answers 503, and no Android purchase can grant premium. AGENTS.md lists the
# Play Console + Pub/Sub setup this depends on.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
# Optional: comma-separated subscription product ids that grant premium. Unset
# = any subscription under com.sparklet.android does, which is correct only
# while premium is the single product on sale.
GOOGLE_PLAY_PRODUCT_IDS=""

# ---- Google AdSense (free-tier ads) ----
# Unset = ad slide skipped in the feed, no script injected. Real ads only
# serve on a domain registered/approved in your AdSense account — expect
# blank space on localhost or an unapproved domain, not an error.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_ID=""

# ---- Web Push (PWA reminders) ----
# Generate once with: npx web-push generate-vapid-keys
# Unset = reminders UI hidden and nudge endpoint no-ops.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"
# Used by `generate-content.ts --top-up` to read /api/inventory:
APP_URL=""
# Top-up tuning (optional): threshold of published cards per category, and
# how many cards to generate per category per run.
MIN_BANK="40"
TOPUP_COUNT="10"

# ---- Other optional tuning (defaults in code; shown here so they're findable)
# TOPUP_HEADROOM="15"          cards above the most any recently-active user has seen
# TOPUP_MAX_CATEGORIES="14"    categories per nightly run — caps Gemini spend
# TOPUP_BONUS_COUNT="5"        extra cards per category when a run has capacity left
# ENRICH_MAX_PER_RUN="120"     cards given quizzes/guesses per deploy
# ARTICLE_MAX_PER_RUN="40"     articles per synchronous run (--batch isn't capped by this)
# ARTICLE_BATCH_MAX="200"      cards per submitted article batch
# ARTICLE_RETRY_SHORT="1"      re-attempt articles that came in under the 600-word floor
# GEMINI_MODEL="gemini-flash-latest"
# GROQ_MODEL="llama-3.3-70b-versatile"   verifier only — never authors cards
